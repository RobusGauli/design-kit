  "color": {
    "$type": "color",
    "$description": "The SEMANTIC tier: surface / on-surface pairs, which is what makes a contrast check mechanical. The eight required keys are bg, fg, border, accent, accent-fg, danger, danger-fg and focus.",
    "bg": {
      "$value": "{primitive.page}"
    },
    "fg": {
      "$value": "{primitive.gray.900}"
    },
    "border": {
      "$value": "{primitive.alpha.200}"
    },
    "accent": {
      "$value": "{primitive.ink}"
    },
    "accent-fg": {
      "$value": "{primitive.ink-on}"
    },
    "danger": {
      "$description": "The danger SURFACE; danger-fg is what sits on it.",
      "$value": "{primitive.signal.red-dim}"
    },
    "danger-fg": {
      "$value": "{primitive.signal.red-ink}"
    },
    "focus": {
      "$value": "{primitive.ink}"
    },
    "danger-strong": {
      "$description": "The MARK: a dot, an invalid ring. Non-text, so 3:1 is its floor and it is not paired.",
      "$value": "{primitive.signal.red}"
    },
    "success": {
      "$value": "{primitive.signal.green-dim}"
    },
    "success-fg": {
      "$value": "{primitive.signal.green-ink}"
    },
    "success-strong": {
      "$value": "{primitive.signal.green}"
    },
    "warn": {
      "$value": "{primitive.signal.amber-dim}"
    },
    "warn-fg": {
      "$value": "{primitive.signal.amber-ink}"
    },
    "warn-strong": {
      "$value": "{primitive.signal.amber}"
    },
    "surface": {
      "$description": "What a card is made of — one step up from the page ground.",
      "$value": "{primitive.gray.0}"
    },
    "surface-2": {
      "$value": "{primitive.gray.100}"
    },
    "muted": {
      "$value": "{primitive.gray.600}"
    },
    "quiet": {
      "$value": "{primitive.gray.500}"
    }
  },
