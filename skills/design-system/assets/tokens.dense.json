  "text": {
    "$description": "Size and line height paired — naming the size sets the leading. THE FLOOR IS 12px.",
    "xs": {
      "size": {
        "$type": "dimension",
        "$value": "12px"
      },
      "leading": {
        "$type": "number",
        "$value": 1.3
      }
    },
    "sm": {
