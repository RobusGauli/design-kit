  "shadow": {
    "$type": "shadow",
    "1": {
      "$value": "{primitive.elevation.rest}"
    },
    "2": {
      "$value": "{primitive.elevation.hover}"
    },
    "3": {
      "$value": "{primitive.elevation.pop}"
    },
    "hairline": {
      "$value": "inset 0 0 0 1px {color.border}"
    },
    "hairline-soft": {
      "$value": "inset 0 0 0 1px {primitive.alpha.100}"
    },
    "hairline-strong": {
      "$value": "inset 0 0 0 1px {primitive.alpha.300}"
    },
    "focus": {
      "$description": "A ground-coloured gap and then the accent — far past WCAG 1.4.11's 3:1.",
      "$value": "0 0 0 2px {primitive.gray.0}, 0 0 0 3px {color.focus}"
    },
    "edge-raised": {
      "$description": "What makes a raised card read as raised, PER THEME: in dark every surface sits 1.09:1 off the ground and the light theme's shadow is invisible, so dark trades it for a 1px edge.",
      "$value": "{shadow.hairline-soft}, {shadow.1}",
      "$extensions": {
        "ds.design/modes": {
          "dark": "inset 0 0 0 1px {primitive.alpha.300}, {shadow.1}"
        }
      }
    }
  },
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": "120ms"
    },
    "base": {
      "$type": "duration",
      "$value": "200ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "280ms"
    },
    "easing": {
      "$type": "cubicBezier",
      "$value": [0.2, 0.8, 0.2, 1]
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": {
      "$value": "640px"
    },
    "md": {
      "$value": "768px"
    },
    "lg": {
      "$value": "1024px"
    }
  },
  "font": {
    "$type": "fontFamily",
    "$description": "THE ONE BRAND OVERRIDE POINT. Put your own face first and every component follows.",
    "sans": {
      "$value": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
    },
    "mono": {
      "$value": "ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, monospace"
    }
  },
  "track": {
    "$type": "dimension",
    "head": {
      "$value": "-0.025em"
    },
    "ui": {
      "$value": "-0.015em"
    },
    "none": {
      "$value": "0"
    }
  },
  "meta": {
    "color-scheme": {
      "$type": "string",
      "$description": "A PLAIN property, not a custom one — it is what makes the UA's own controls and scrollbars follow the theme.",
      "$value": "light",
      "$extensions": {
        "ds.design/css": {
          "property": "color-scheme"
        },
        "ds.design/modes": {
          "dark": "dark"
        }
      }
    }
  }
}
